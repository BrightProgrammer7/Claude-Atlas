# Names only. Real values live in the Vercel project settings or a local, gitignored file.
# Azure Speech: the /api/speech-token route trades these for a short-lived browser token.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# AI Gateway: on Vercel the /api/ask route authenticates with OIDC automatically.
# Locally, `vercel env pull` provides VERCEL_OIDC_TOKEN.
